// Security policy for MeCab-Ko Elasticsearch Plugin

grant {
    // Allow loading native libraries
    permission java.lang.RuntimePermission "loadLibrary.*";
    permission java.lang.RuntimePermission "accessDeclaredMembers";

    // Allow reading system properties
    permission java.util.PropertyPermission "os.name", "read";
    permission java.util.PropertyPermission "os.arch", "read";
    permission java.util.PropertyPermission "java.io.tmpdir", "read";

    // Allow creating temp files for native library extraction
    permission java.io.FilePermission "${java.io.tmpdir}/-", "read,write,delete";
    permission java.io.FilePermission "${java.io.tmpdir}", "read,write";

    // Allow reading plugin resources
    permission java.io.FilePermission "<<ALL FILES>>", "read";

    // Allow reading config files
    permission java.io.FilePermission "${path.home}/config/-", "read";
    permission java.io.FilePermission "${path.home}/plugins/-", "read";
};
