  "deployment_architecture": {
    "workflow_pipeline": {
      "stage_1_trigger": {
        "description": "Code Push Event",
        "condition": "Push to main/master/develop or PR creation",
        "paths_watched": [
          "rust/**",
          "docs/**",
          ".github/workflows/docs.yml",
          "Cargo.toml"
        ]
      },
      "stage_2_build": {
        "parallel_jobs": [
          {
            "job": "build-rustdoc",
            "runtime": "2-5 minutes",
            "cache": "cargo build artifacts",
            "output": "Rustdoc HTML"
          },
          {
            "job": "build-mdbook",
            "runtime": "1-2 minutes",
            "depends_on": "mdBook installation",
            "output": "mdBook HTML"
          }
        ]
      },
      "stage_3_combine": {
        "description": "Merge documentation artifacts",
        "creates": "Landing page with dual navigation",
        "artifacts": [
          "docs-combined/index.html (main landing page)",
          "docs-combined/api/ (Rustdoc)",
          "docs-combined/book/ (mdBook)"
        ]
      },
      "stage_4_deploy": {
        "condition": "Only on successful main/master push",
        "method": "GitHub Actions deploy-pages action",
        "target": "GitHub Pages environment",
        "url": "https://hephaex.github.io/mecab-ko/"
      }
    },
    "permissions_required": {
      "contents": "read",
      "pages": "write",
      "id_token": "write"
    },
    "deployment_environment": {
      "name": "github-pages",
      "protection_rules": "Can add if needed",
      "concurrency": "Single workflow execution (cancels in-progress)"
    }
  },
