  "troubleshooting_guide": {
    "issues": [
      {
        "problem": "Workflow fails: 'mdbook command not found'",
        "cause": "mdBook not installed in GitHub Actions runner",
        "solution": [
          "Check workflow uses: 'cargo install mdbook --version 0.4.48'",
          "Verify Rust toolchain is installed before mdbook",
          "Current workflow is correct - should not occur"
        ]
      },
      {
        "problem": "Documentation not deployed to GitHub Pages",
        "cause": [
          "GitHub Pages not enabled",
          "Build source not set to 'GitHub Actions'",
          "Workflow not triggered"
        ],
        "solution": [
          "1. Verify Settings > Pages > Source = 'GitHub Actions'",
          "2. Check Actions tab for workflow execution",
          "3. Review job logs for errors",
          "4. Ensure .github/workflows/docs.yml exists and is valid"
        ]
      },
      {
        "problem": "Custom domain not working",
        "cause": "DNS records not propagated or incorrectly configured",
        "solution": [
          "Verify CNAME record: dig mecab-ko.dev",
          "Check DNS propagation with online tools (dnschecker.org)",
          "Wait up to 48 hours for full propagation",
          "Re-enter custom domain in GitHub Pages settings"
        ]
      },
      {
        "problem": "HTTPS not enforced",
        "cause": "SSL certificate not issued yet",
        "solution": [
          "Wait 5-10 minutes after first deployment",
          "Remove and re-add custom domain if waiting >1 hour",
          "Check GitHub Pages settings for certificate status"
        ]
      },
      {
        "problem": "Built documentation looks broken (missing CSS/JS)",
        "cause": "Incorrect asset paths or relative URL issues",
        "solution": [
          "Check custom.css is referenced in book.toml",
          "Verify build-dir in book.toml matches output path",
          "Clear browser cache and rebuild",
          "Check browser console for 404 errors"
        ]
      },
      {
        "problem": "Search not working on deployed site",
        "cause": "Search index not built or served",
        "solution": [
          "Verify search is enabled in book.toml",
          "Check 'searchindex.json' exists in built output",
          "Clear browser cache",
          "Try in incognito/private mode"
        ]
      }
    ]
  },
