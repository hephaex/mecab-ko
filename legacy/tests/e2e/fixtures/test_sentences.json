{
  "version": "1.0.0",
  "description": "Common test sentences for MeCab-Ko E2E testing",
  "test_cases": [
    {
      "id": "basic_001",
      "description": "Simple sentence with common words",
      "input": "나는 학교에 갑니다.",
      "expected_tokens": [
        {"surface": "나", "pos": "NP"},
        {"surface": "는", "pos": "JX"},
        {"surface": "학교", "pos": "NNG"},
        {"surface": "에", "pos": "JKB"},
        {"surface": "가", "pos": "VV"},
        {"surface": "ㅂ니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
    },
    {
      "id": "basic_002",
      "description": "Sentence with verb conjugation",
      "input": "오늘은 날씨가 좋습니다.",
      "expected_tokens": [
        {"surface": "오늘", "pos": "NNG"},
        {"surface": "은", "pos": "JX"},
        {"surface": "날씨", "pos": "NNG"},
        {"surface": "가", "pos": "JKS"},
        {"surface": "좋", "pos": "VA"},
        {"surface": "습니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
    },
    {
      "id": "basic_003",
      "description": "Question sentence",
      "input": "이것은 무엇입니까?",
