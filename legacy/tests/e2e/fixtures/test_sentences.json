        {"surface": "Python", "pos": "SL"},
        {"surface": "은", "pos": "JX"},
        {"surface": "프로그래밍", "pos": "NNG"},
        {"surface": "언어", "pos": "NNG"},
        {"surface": "이", "pos": "VCP"},
        {"surface": "ㅂ니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
