        {"surface": "이것", "pos": "NP"},
        {"surface": "은", "pos": "JX"},
        {"surface": "무엇", "pos": "NP"},
        {"surface": "이", "pos": "VCP"},
        {"surface": "ㅂ니까", "pos": "EF"},
        {"surface": "?", "pos": "SF"}
      ]
    },
    {
      "id": "compound_001",
      "description": "Compound noun",
      "input": "대한민국의 수도는 서울입니다.",
      "expected_tokens": [
        {"surface": "대한민국", "pos": "NNP"},
        {"surface": "의", "pos": "JKG"},
        {"surface": "수도", "pos": "NNG"},
        {"surface": "는", "pos": "JX"},
        {"surface": "서울", "pos": "NNP"},
        {"surface": "이", "pos": "VCP"},
        {"surface": "ㅂ니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
    },
    {
