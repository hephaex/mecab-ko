        {"surface": ".", "pos": "SF"},
        {"surface": ".", "pos": "SF"},
        {"surface": ".", "pos": "SF"},
        {"surface": "!", "pos": "SF"},
        {"surface": "!", "pos": "SF"},
        {"surface": "!", "pos": "SF"},
        {"surface": "?", "pos": "SF"},
        {"surface": "?", "pos": "SF"},
        {"surface": "?", "pos": "SF"}
      ]
    },
    {
      "id": "long_sentence",
      "description": "Long sentence test",
      "input": "형태소 분석은 자연어 처리의 가장 기본적인 작업 중 하나로, 문장을 의미 있는 최소 단위인 형태소로 분리하고 각 형태소의 품사를 판별하는 과정입니다.",
      "min_tokens": 20
    },
    {
      "id": "user_dict_001",
      "description": "User dictionary test (if supported)",
      "input": "카카오톡으로 메시지를 보냈습니다.",
      "note": "Tests user dictionary integration"
    }
  ],
  "performance_tests": [
    {
      "id": "perf_001",
      "description": "Performance test with repeated text",
      "input": "나는 학교에 갑니다. ",
      "repeat": 1000,
      "max_time_ms": 1000
    }
  ],
  "error_cases": [
    {
      "id": "error_001",
      "description": "Invalid UTF-8 handling",
      "note": "Implementation specific - test graceful degradation"
    },
    {
      "id": "error_002",
      "description": "Extremely long input",
      "input_generator": "repeat_char",
      "char": "가",
      "count": 100000,
      "note": "Tests memory handling"
    }
  ]
}
