        {"surface": "었", "pos": "EP"},
        {"surface": "습니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
    },
    {
      "id": "edge_empty",
      "description": "Empty string",
      "input": "",
      "expected_tokens": []
    },
    {
      "id": "edge_whitespace",
      "description": "Only whitespace",
      "input": "   \t\n  ",
      "expected_tokens": []
    },
    {
      "id": "edge_punctuation",
      "description": "Only punctuation",
      "input": "...!!!???",
