        {"surface": "2024", "pos": "SN"},
        {"surface": "년", "pos": "NNBC"},
        {"surface": "1", "pos": "SN"},
        {"surface": "월", "pos": "NNBC"},
        {"surface": "5", "pos": "SN"},
        {"surface": "일", "pos": "NNBC"},
        {"surface": "이", "pos": "VCP"},
        {"surface": "ㅂ니다", "pos": "EF"},
        {"surface": ".", "pos": "SF"}
      ]
    },
    {
      "id": "honorific_001",
      "description": "Honorific speech",
      "input": "선생님께서 말씀하셨습니다.",
      "expected_tokens": [
        {"surface": "선생님", "pos": "NNG"},
        {"surface": "께서", "pos": "JKS"},
        {"surface": "말씀", "pos": "NNG"},
        {"surface": "하", "pos": "XSV"},
