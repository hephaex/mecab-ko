{
  "settings": {
    "analysis": {
      "tokenizer": {
        "my_nori_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed",
          "user_dictionary": "userdict_ko.txt"
        }
      },
      "filter": {
        "my_nori_pos": {
          "type": "nori_part_of_speech",
          "stoptags": ["E", "J", "SC", "SE", "SF", "SP", "SSC", "SSO", "SY", "UNA", "UNKNOWN", "VCP", "VCN", "VX"]
        },
        "my_nori_reading": {
          "type": "nori_reading_form"
        }
      },
      "analyzer": {
        "nori_analyzer": {
          "type": "nori",
          "decompound_mode": "mixed",
          "stoptags": ["E", "J", "SC", "SE", "SF"]
        },
        "custom_nori": {
          "type": "custom",
          "tokenizer": "my_nori_tokenizer",
          "filter": [
            "my_nori_pos",
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "content": {
        "type": "text",
        "analyzer": "nori_analyzer",
        "fields": {
          "custom": {
            "type": "text",
            "analyzer": "custom_nori"
          }
        }
      }
    }
  }
}
